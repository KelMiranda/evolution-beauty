---
import SectionHeading from './SectionHeading.astro';

const testimonials = [
  {
    quote: 'Con este módulo podemos capturar la información de cada participante sin perder control sobre los registros.',
    name: 'Módulo 1',
    role: 'Formulario + base local',
  },
  {
    quote: 'El listado permite buscar rápido, revisar registros y preparar reportes básicos para validación operativa.',
    name: 'Listado',
    role: 'Consulta y exportación',
  },
  {
    quote: 'La arquitectura queda lista para migrar después a base de datos real y Docker sin rehacer la interfaz.',
    name: 'Escalabilidad',
    role: 'Preparado para VPS',
  },
];
---

<section id="reporte" class="py-20 md:py-28 border-t border-ink/10">
  <div class="container-page">
    <SectionHeading
      eyebrow="Reporte básico"
      title="Resumen operativo del módulo"
      align="center"
    />

    <div class="grid md:grid-cols-3 gap-8 mt-14">
      {testimonials.map((t) => (
        <figure class="bg-sand-50/40 p-8 flex flex-col h-full">
          <div class="text-gold-200 text-sm mb-4" aria-hidden="true">ACOES</div>
          <blockquote class="flex-1 text-ink/75 leading-relaxed mb-6">
            "{t.quote}"
          </blockquote>
          <figcaption>
            <p class="font-medium text-sm">{t.name}</p>
            <p class="text-xs text-ink/50 mt-0.5">{t.role}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
