---
interface Props {
  metrics: {
    total: number;
    today: number;
    consent: number;
    email: number;
    active: number;
    inactive: number;
  };
}

const { metrics } = Astro.props as Props;

const stats = [
  {
    value: metrics.total,
    label: 'Total registrados',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    value: metrics.today,
    label: 'Registrados hoy',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`,
  },
  {
    value: metrics.consent,
    label: 'Con consentimiento',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    value: metrics.email,
    label: 'Con correo',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
  {
    value: metrics.active,
    label: 'Activos',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    value: metrics.inactive,
    label: 'Inactivos',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>`,
  },
];
---

<section class="bg-ink text-cream py-16 md:py-20">
  <div class="container-page">
    <div class="mb-10">
      <p class="font-accent text-xs font-semibold uppercase tracking-[0.25em] text-gold-200/80">Resumen general</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      {stats.map((stat) => (
        <div class="group relative flex flex-col gap-4 rounded-card bg-white/5 p-5 border border-white/8 hover:bg-white/10 hover:border-white/12 transition-all duration-500 hover:-translate-y-1">
          <div class="flex items-start justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-button bg-gold-200/10 text-gold-50 transition-transform duration-300 group-hover:scale-110" set:html={stat.icon} />
            <span class="font-display text-4xl font-light tabular-nums text-cream counter" data-target={stat.value}>
              {stat.value}
            </span>
          </div>
          <p class="font-body text-[10px] uppercase tracking-[0.20em] text-cream/55 leading-relaxed">
            {stat.label}
          </p>
          <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-gold-200/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        </div>
      ))}
    </div>
  </div>
</section>
