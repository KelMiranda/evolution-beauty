---
const highlights = [
  'Acceso público para conocer ACOES',
  'Registro guiado y validado antes de guardar',
  'Base central para seguimiento interno',
];
---

<section id="resumen" class="relative pt-32 pb-20 md:pt-44 md:pb-28 overflow-hidden">
  <!-- Floating decorative elements -->
  <div class="absolute top-20 left-10 w-20 h-20 rounded-full bg-gold-200/20 float-slow pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-40 right-20 w-32 h-32 rounded-full bg-sand-200/30 float pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-20 left-1/4 w-16 h-16 rounded-full bg-gold-100/20 float-reverse pointer-events-none" aria-hidden="true"></div>

  <div class="container-page grid lg:grid-cols-12 gap-10 lg:gap-6 items-end">
    <div class="lg:col-span-7">
      <p class="eyebrow mb-6 reveal" style="--stagger-delay: 100ms;">Asociación de Cosmetólogas y Estilistas de El Salvador</p>
      
      <h1 class="text-display-xl font-medium mb-8 reveal" style="--stagger-delay: 200ms;">
        <span class="text-reveal"><span>ACOES</span></span>
        <span class="block italic font-light text-gold-200 text-reveal"><span>Portal de registro y directorio</span></span>
      </h1>
      
      <p class="text-lg md:text-xl text-ink/65 max-w-lg mb-10 leading-relaxed reveal" style="--stagger-delay: 300ms;">
        Centraliza el registro, la validación y el acceso interno al directorio de ACOES con una experiencia clara y profesional.
      </p>

      <ul class="space-y-3 mb-10">
        {highlights.map((item, i) => (
          <li class="flex items-start gap-3 text-sm md:text-base text-ink/75 reveal" style={`--stagger-delay: ${400 + i * 100}ms;`}>
            <span class="mt-2 w-1.5 h-1.5 rounded-full bg-gold-200 shrink-0"></span>
            {item}
          </li>
        ))}
      </ul>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <a href="/registro" class="btn-primary reveal" style="--stagger-delay: 700ms;">Ir al registro</a>
        <p class="text-xs uppercase tracking-wide text-ink/50 reveal" style="--stagger-delay: 800ms;">
          📍 Registro público · Panel interno privado
        </p>
      </div>
    </div>

    <div class="lg:col-span-5 reveal" style="--stagger-delay: 400ms;">
      <div class="relative aspect-[4/5] w-full max-w-md ml-auto parallax-container">
        <img
          src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=900&q=80"
          alt="Participantes y equipo de ACOES trabajando con registros y formularios"
          class="w-full h-full object-cover parallax-element"
          data-speed="0.3"
          width="900"
          height="1125"
          loading="eager"
        />
        <div class="absolute bottom-0 left-0 right-0 bg-ink/85 backdrop-blur-sm text-cream px-6 py-5 flex items-center justify-between">
          <div>
            <p class="text-2xl font-display">Portal</p>
            <p class="text-[11px] uppercase tracking-widest-2 text-cream/60">Registro guiado</p>
          </div>
          <div class="w-px h-8 bg-cream/20"></div>
          <div>
            <p class="text-2xl font-display">ACOES</p>
            <p class="text-[11px] uppercase tracking-widest-2 text-cream/60">Base central</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
