---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  light?: boolean;
}

const { eyebrow, title, description, align = 'left', light = false } = Astro.props;
---

<div class:list={[
  'max-w-2xl',
  { 'mx-auto text-center': align === 'center' },
]}>
  <p class:list={['font-accent text-xs font-semibold uppercase tracking-[0.25em] mb-6 reveal', light ? 'text-gold-200/80' : 'text-gold-200']}>{eyebrow}</p>
  <h2 class:list={[
    'font-display text-display-lg font-light mb-6 text-reveal',
    { 'text-cream': light },
  ]}>
    <span>{title}</span>
  </h2>
  {description && (
    <p class:list={[
      'font-body text-base md:text-lg leading-relaxed reveal',
      light ? 'text-cream/70' : 'text-ink/60',
    ]}>
      {description}
    </p>
  )}
</div>
