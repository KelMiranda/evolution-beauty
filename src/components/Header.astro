---
interface Props {
  mode?: 'public' | 'dashboard';
  user?: {
    full_name: string;
    role: string;
  } | null;
}

const { user = null, mode = user ? 'dashboard' : 'public' } = Astro.props as Props;
const canViewDashboardLinks = user?.role === 'admin';
const canCreateParticipantLinks = user?.role === 'admin' || user?.role === 'facilitadora';

const currentPath = Astro.url.pathname;

const publicNavLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Proceso', href: '#proceso' },
  { label: 'Contacto', href: '#contacto' },
];

const dashboardNavLinks = [
  ...(canViewDashboardLinks ? [
    { label: 'Resumen', href: '/dashboard' },
    { label: 'Participantes', href: '/dashboard/participantes' },
    { label: 'Usuarios', href: '/dashboard/usuarios' },
    { label: 'Auditoría', href: '/dashboard/auditoria' },
    { label: 'Reportes', href: '/dashboard/exportaciones' },
  ] : []),
  ...(canCreateParticipantLinks ? [
    { label: 'Alta', href: '/dashboard/participantes/nuevo' },
  ] : []),
];

const navLinks = mode === 'dashboard' ? dashboardNavLinks : publicNavLinks;

function isActive(href: string) {
  if (href.startsWith('#')) return false;
  return currentPath === href || (href !== '/' && currentPath.startsWith(href));
}

const roleBadgeClass: Record<string, string> = {
  admin: 'bg-gold-200/15 text-gold-200',
  facilitadora: 'bg-blue-100/60 text-blue-700',
  participante: 'bg-emerald-100/60 text-emerald-700',
};
---

<header class:list={[
  'fixed top-0 inset-x-0 z-50 backdrop-blur-xl border-b transition-shadow duration-300',
  mode === 'dashboard' ? 'bg-cream/90 border-ink/10 shadow-sm' : 'bg-white/80 border-ink/8',
] }>
  <nav class="container-page flex items-center justify-between h-[72px]">
    <a href={mode === 'dashboard' ? '/dashboard' : '/'} class="group flex items-baseline gap-2">
      <span class="font-display text-2xl font-light tracking-tight text-ink transition-all duration-300 group-hover:text-gold-200">ACOES</span>
      <span class="font-accent text-[10px] font-semibold uppercase tracking-[0.30em] text-ink/40">{mode === 'dashboard' ? 'Directorio' : 'Portal'}</span>
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'font-body text-xs font-semibold uppercase tracking-[0.20em] transition-all duration-300 relative pb-0.5',
              isActive(link.href)
                ? 'text-ink'
                : 'text-ink/55 hover:text-ink',
            ]}
          >
            {link.label}
            <span
              class:list={[
                'absolute bottom-0 left-0 h-px bg-gold-200 transition-all duration-300',
                isActive(link.href) ? 'w-full' : 'w-0 group-hover:w-full',
              ]}
            />
          </a>
        </li>
      ))}
    </ul>

    {mode === 'dashboard' && user ? (
      <div class="hidden md:flex items-center gap-4">
        <div class="flex items-center gap-3">
          <div class="text-right">
            <p class="text-[9px] font-semibold uppercase tracking-[0.25em] text-ink/40 mb-0.5">Rol</p>
            <span class:list={[
              'inline-flex items-center rounded-chip px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide',
              roleBadgeClass[user.role] ?? 'bg-slate-100 text-slate-600',
            ]}>
              {user.role}
            </span>
          </div>
          <div class="h-8 w-px bg-ink/10" />
          <div class="text-right">
            <p class="text-[9px] font-semibold uppercase tracking-[0.25em] text-ink/40 mb-0.5">Usuario</p>
            <p class="text-sm font-medium text-ink leading-none">{user.full_name}</p>
          </div>
        </div>
        <form method="post" action="/api/logout">
          <button
            class="group inline-flex items-center gap-2.5 rounded-button border border-ink/12 bg-white/80 px-4 py-2.5 text-[11px] font-semibold uppercase tracking-wide text-ink shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-ink/20 hover:shadow-md hover:text-gold-200 active:scale-[0.98]"
            type="submit"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" x2="9" y1="12" y2="12"/>
            </svg>
            <span>Salir</span>
          </button>
        </form>
      </div>
    ) : (
      <div class="hidden md:flex items-center gap-3">
        <a href="/login" class="inline-flex items-center rounded-button border border-ink/12 bg-white/80 px-5 py-2.5 text-[11px] font-semibold uppercase tracking-wide text-ink shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-ink/20 hover:shadow-md">Ingresar</a>
        {mode === 'public' ? <a href="/registro" class="btn-primary !px-5 !py-2.5 !text-[11px]">Registrar</a> : null}
      </div>
    )}

    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center gap-1.5 p-2 rounded-button hover:bg-ink/5 transition-colors duration-300"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="w-5 h-px bg-ink transition-all duration-300 menu-line-1"></span>
      <span class="w-5 h-px bg-ink transition-all duration-300 menu-line-2"></span>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-ink/8 bg-cream/95 backdrop-blur-xl">
    <ul class="container-page py-6 flex flex-col gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'flex items-center px-4 py-3.5 rounded-button text-sm font-semibold uppercase tracking-wide transition-all duration-200 mb-1',
              isActive(link.href)
                ? 'bg-gold-50/80 text-gold-200'
                : 'text-ink/70 hover:bg-sand-50/60 hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2 pt-2 border-t border-ink/8">
        {mode === 'dashboard' && user ? (
          <form method="post" action="/api/logout">
            <button class="group inline-flex w-full items-center gap-2.5 rounded-button border border-ink/12 bg-white/80 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-ink shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-ink/20 hover:shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" x2="9" y1="12" y2="12"/>
              </svg>
              <span>Salir</span>
            </button>
          </form>
        ) : (
          <a href="/login" class="btn-primary w-full !py-3 !text-xs">Ingresar</a>
        )}
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
