---
import type { ParticipantIndicators } from '../lib/server/participants';

interface Props {
  indicators: ParticipantIndicators;
  dateFrom?: string;
  dateTo?: string;
}

const { indicators, dateFrom, dateTo } = Astro.props as Props;

const sections = [
  {
    key: 'byDepartment',
    label: 'Por departamento',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
  {
    key: 'byProgram',
    label: 'Por programa',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
  {
    key: 'byEducationLevel',
    label: 'Por nivel educativo',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  },
  {
    key: 'byRoleFunction',
    label: 'Por función',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>`,
  },
  {
    key: 'byGender',
    label: 'Por género',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
] as const;

function sortByCount(obj: Record<string, number>) {
  return Object.entries(obj).sort((a, b) => b[1] - a[1]);
}
---

<section class="container-page py-16 md:py-20">
  <div class="mb-10">
    <p class="section-eyebrow mb-4">Indicadores</p>
    <div class="flex items-end justify-between">
      <h2 class="text-display-md font-medium">Desglose de participantes</h2>
      {dateFrom || dateTo ? (
        <p class="text-xs font-medium text-ink/50 uppercase tracking-widest">
          Período: {dateFrom ?? 'inicio'} — {dateTo ?? 'actual'}
        </p>
      ) : null}
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {sections.map(({ key, label, icon }) => {
      const data = sortByCount(indicators[key]);
      const total = data.reduce((sum, [, count]) => sum + count, 0);
      const maxCount = data[0]?.[1] ?? 0;
      return (
        <div class="card group">
          <div class="flex items-center gap-2.5 mb-5">
            <span class="flex h-8 w-8 items-center justify-center rounded-button bg-gold-50 text-gold-200 shadow-sm" set:html={icon} />
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-ink/55">{label}</p>
          </div>

          {data.length === 0 ? (
            <div class="flex flex-col items-center justify-center py-8 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-ink/20 mb-3">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 12h8"/>
              </svg>
              <p class="text-sm text-ink/35">Sin datos disponibles</p>
            </div>
          ) : (
            <div class="space-y-3">
              {data.map(([name, count]) => {
                const pct = total > 0 ? (count / total) * 100 : 0;
                const barWidth = maxCount > 0 ? (count / maxCount) * 100 : 0;
                return (
                  <div class="flex flex-col gap-1.5">
                    <div class="flex items-center justify-between">
                      <span class="text-sm font-medium text-ink truncate max-w-[60%]" title={name}>{name}</span>
                      <div class="flex items-center gap-2 shrink-0">
                        <span class="text-sm font-semibold text-ink tabular-nums">{count}</span>
                        <span class="text-[10px] font-semibold text-ink/35 tabular-nums w-8 text-right">{pct.toFixed(0)}%</span>
                      </div>
                    </div>
                    <div class="progress-bar">
                      <div class="progress-bar__fill" style={`width: ${barWidth}%`} />
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      );
    })}
  </div>
</section>
