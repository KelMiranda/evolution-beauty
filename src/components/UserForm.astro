---
import { canonicalRoles } from '../lib/server/permissions';
import type { UserRow } from '../lib/server/users';

interface Props {
  mode: 'create' | 'edit';
  user?: UserRow | null;
  errors?: Record<string, string>;
}

const { mode, user, errors = {} } = Astro.props as Props;
const isEdit = mode === 'edit';
---

<form class="bg-sand-50/40 p-8 md:p-10 grid sm:grid-cols-2 gap-5" method="post" action={isEdit ? `/api/users/${user?.id}` : '/api/users'} id="user-form">
  <div class="sm:col-span-2 form-field">
    <label for="email" class="block text-xs uppercase tracking-wide text-ink/60 mb-2">Correo electrónico</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      placeholder="correo@ejemplo.com"
      value={user?.email ?? ''}
      class="w-full bg-cream border border-ink/15 px-4 py-3 text-sm outline-none transition-all duration-300 focus:border-gold-200 focus:shadow-lg focus:shadow-gold-200/10 focus:scale-[1.02]"
    />
    {errors.email ? <p class="text-xs text-red-500 mt-1">{errors.email}</p> : null}
  </div>

  {isEdit ? null : (
    <div class="sm:col-span-2 form-field">
      <label for="password" class="block text-xs uppercase tracking-wide text-ink/60 mb-2">Contraseña</label>
      <input
        type="password"
        id="password"
        name="password"
        required={!isEdit}
        autocomplete={isEdit ? 'new-password' : 'off'}
        placeholder="Mínimo 8 caracteres"
        class="w-full bg-cream border border-ink/15 px-4 py-3 text-sm outline-none transition-all duration-300 focus:border-gold-200 focus:shadow-lg focus:shadow-gold-200/10 focus:scale-[1.02]"
      />
      {errors.password ? <p class="text-xs text-red-500 mt-1">{errors.password}</p> : null}
    </div>
  )}

  <div class="sm:col-span-2 form-field">
    <label for="fullName" class="block text-xs uppercase tracking-wide text-ink/60 mb-2">Nombre completo</label>
    <input
      type="text"
      id="fullName"
      name="fullName"
      required
      autocomplete="name"
      placeholder="Nombre completo"
      value={user?.full_name ?? ''}
      class="w-full bg-cream border border-ink/15 px-4 py-3 text-sm outline-none transition-all duration-300 focus:border-gold-200 focus:shadow-lg focus:shadow-gold-200/10 focus:scale-[1.02]"
    />
    {errors.fullName ? <p class="text-xs text-red-500 mt-1">{errors.fullName}</p> : null}
  </div>

  <div class="sm:col-span-1 form-field">
    <label for="role" class="block text-xs uppercase tracking-wide text-ink/60 mb-2">Rol</label>
    <select
      id="role"
      name="role"
      required
      class="w-full bg-cream border border-ink/15 px-4 py-3 text-sm outline-none transition-all duration-300 focus:border-gold-200 focus:shadow-lg focus:shadow-gold-200/10 focus:scale-[1.02] cursor-pointer"
    >
      <option value="" disabled>Selecciona</option>
      {canonicalRoles.map((role) => (
        <option value={role} selected={user?.role === role}>{role}</option>
      ))}
    </select>
    {errors.role ? <p class="text-xs text-red-500 mt-1">{errors.role}</p> : null}
  </div>

  {isEdit ? (
    <div class="sm:col-span-1 form-field flex items-end">
      <label class="inline-flex items-center gap-2 text-sm text-ink/70">
        <input
          type="checkbox"
          name="active"
          class="rounded border-ink/20 text-gold-200 focus:ring-gold-200"
          checked={user?.active ?? true}
        />
        Usuario activo
      </label>
    </div>
  ) : (
    <input type="hidden" name="active" value="true" />
  )}

  <div class="sm:col-span-2">
    <button type="submit" class="btn-primary w-full sm:w-auto group">
      <span>{isEdit ? 'Guardar cambios' : 'Crear usuario'}</span>
      <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </button>
    <p class="text-xs text-ink/40 mt-3" id="form-status" role="status" aria-live="polite"></p>
  </div>
</form>
