---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  backHref: string;
  saveAction: string;
  data: Record<string, string | boolean>;
  consent: boolean;
  errors?: Record<string, string[] | undefined> | null;
}

const { title, description, backHref, saveAction, data, consent, errors = null } = Astro.props as Props;
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen py-24 px-6">
    <div class="container-page max-w-3xl">
      <p class="eyebrow mb-4">Revisión previa</p>
      <h1 class="text-display-lg font-medium mb-4">{title}</h1>
      <p class="text-ink/60 mb-8">{description}</p>

      {errors ? (
        <div class="bg-red-50 border border-red-200 text-red-700 p-5 mb-8">
          <p class="font-semibold mb-2">Hay errores en el formulario:</p>
          <ul class="list-disc pl-5 space-y-1 text-sm">
            {Object.entries(errors).map(([field, messages]) => (
              <li><strong>{field}</strong>: {messages?.join(', ')}</li>
            ))}
          </ul>
          <a href={backHref} class="inline-block mt-4 underline">Volver al formulario</a>
        </div>
      ) : null}

      <div class="bg-cream border border-ink/10 p-6 md:p-8 space-y-4 rounded-[24px] shadow-[0_20px_60px_-36px_rgba(22,20,18,0.45)]">
        <div class="grid md:grid-cols-2 gap-4 text-sm">
          <p><strong>Nombre:</strong> {data.fullName}</p>
          <p><strong>Documento:</strong> {data.documentNumber}</p>
          <p><strong>Nacimiento:</strong> {data.birthDate}</p>
          <p><strong>Género:</strong> {data.gender}</p>
          <p><strong>País:</strong> {data.phoneCountry}</p>
          <p><strong>Celular:</strong> {data.phoneDialCode} {data.phoneNumber}</p>
          <p><strong>Departamento:</strong> {data.department}</p>
          <p><strong>Municipio:</strong> {data.municipality}</p>
          <p><strong>Distrito:</strong> {data.district || '—'}</p>
          <p><strong>Entidad:</strong> {data.organization || '—'}</p>
          <p><strong>Función:</strong> {data.roleFunction}</p>
          <p><strong>Nivel educativo:</strong> {data.educationLevel || '—'}</p>
          <p><strong>Programa:</strong> {data.program || '—'}</p>
          <p><strong>Estado:</strong> {data.status}</p>
          <p><strong>Consentimiento:</strong> {consent ? 'Sí' : 'No'}</p>
        </div>

        <div class="pt-4 border-t border-ink/10">
          <p class="text-sm text-ink/60 mb-4">Si todo está correcto, confirma para guardarlo en la base de datos.</p>
          <form method="post" action={saveAction} class="flex flex-col sm:flex-row gap-3">
            {Object.entries(data).filter(([key]) => key !== 'consent').map(([key, value]) => (
              <input type="hidden" name={key} value={String(value)} />
            ))}
            <input type="hidden" name="consent" value={consent ? 'on' : ''} />
            <a href={backHref} class="btn-secondary text-center">Editar</a>
            <button type="submit" class="btn-primary">Confirmar y guardar</button>
          </form>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
