---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="ACOES — Portal público" description="Portal público de ACOES para conocer el proyecto y registrarse.">
  <Header mode="public" />
  <main>
    <section id="inicio">
      <Hero />
    </section>
    <Features />

    <section id="proceso" class="py-20 md:py-28 border-t border-ink/10">
      <div class="container-page grid gap-8 md:grid-cols-3">
        <div class="rounded-[24px] border border-ink/10 bg-white/80 p-6 shadow-[0_18px_60px_-38px_rgba(22,20,18,0.45)]">
          <p class="eyebrow mb-3">1. Conoce</p>
          <h3 class="text-2xl font-display mb-3">Información clara</h3>
          <p class="text-ink/65 text-sm leading-relaxed">Explora el propósito del directorio ACOES y el acceso disponible para registro.</p>
        </div>
        <div class="rounded-[24px] border border-ink/10 bg-white/80 p-6 shadow-[0_18px_60px_-38px_rgba(22,20,18,0.45)]">
          <p class="eyebrow mb-3">2. Regístrate</p>
          <h3 class="text-2xl font-display mb-3">Formulario guiado</h3>
          <p class="text-ink/65 text-sm leading-relaxed">Completa tus datos en un flujo de revisión antes de guardar la información.</p>
        </div>
        <div class="rounded-[24px] border border-ink/10 bg-white/80 p-6 shadow-[0_18px_60px_-38px_rgba(22,20,18,0.45)]">
          <p class="eyebrow mb-3">3. Confirmación</p>
          <h3 class="text-2xl font-display mb-3">Datos validados</h3>
          <p class="text-ink/65 text-sm leading-relaxed">Tu información pasa por validación antes de almacenarse en la base central.</p>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-28 border-t border-ink/10" id="contacto">
      <div class="container-page grid gap-8 lg:grid-cols-12 items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4">Registro</p>
          <h2 class="text-display-lg font-medium mb-4">Empieza tu registro en ACOES</h2>
          <p class="text-ink/60 leading-relaxed max-w-2xl">Si eres participante o enlace temporal, puedes iniciar el proceso desde el formulario de inscripción. Si ya tienes acceso interno, entra al panel privado.</p>
        </div>
        <div class="lg:col-span-5 flex flex-col sm:flex-row gap-4">
          <a href="/registro" class="btn-primary w-full sm:w-auto">Ir al registro</a>
          <a href="/login" class="btn-secondary w-full sm:w-auto">Entrar al panel</a>
        </div>
      </div>
    </section>
  </main>
  <Footer mode="public" />
</BaseLayout>
