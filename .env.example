DATABASE_URL=postgres://acoes:acoes@localhost:5432/acoes_local
INITIAL_ADMIN_EMAIL=admin@acoes.local
INITIAL_ADMIN_PASSWORD=Admin1234!
NODE_ENV=development
PORT=4321
HOST=0.0.0.0

# The URL the public-facing SPA is served from. Used by the
# POST /api/courses/<id>/public-link endpoint to generate URLs that the
# end-user clicks — must point to the SPA (port 3000), not the backend.
PUBLIC_SITE_URL=http://localhost:3000

# The URL the Astro backend redirects non-API paths to. Defaults to the
# SPA so the SPA's HashRouter can resolve the route. The middleware
# prepends '#' before the path so HashRouter reads the route from the
# fragment.
REACT_APP_URL=http://localhost:3000
