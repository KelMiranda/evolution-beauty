DATABASE_URL=postgres://acoes:acoes@localhost:5432/acoes_local
INITIAL_ADMIN_EMAIL=admin@acoes.local
INITIAL_ADMIN_PASSWORD=Admin1234!
NODE_ENV=development
PORT=4321
HOST=0.0.0.0

# The public origin served by Astro. Used by the
# POST /api/courses/<id>/public-link endpoint to generate HashRouter URLs.
PUBLIC_SITE_URL=http://localhost:4321

# Cloudflare Turnstile (anti-bot)
# Get keys from https://dash.cloudflare.com/ under Turnstile.
# Leave empty in development to skip the widget and server verification.
TURNSTILE_SITEKEY=
VITE_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
